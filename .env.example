# Copy to .env.local and fill in real values:
#   cp .env.example .env.local

# --- Clerk (auth) ---
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (database + pgvector) ---
# Get from Supabase project → Settings → API. Then run lib/supabase/schema.sql
# once in the Supabase SQL Editor to create tables + match_chunks RPC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub token (indexing; strongly recommended) ---
# Personal access token, no scopes needed for public repos.
# Without it, indexing uses anonymous requests (60/hour) and fails on real repos.
# Get from https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Voyage platform key (embeddings only, NOT user BYOK) ---
# Used by lib/rag/embedder.ts with voyage-code-4 during indexing.
# Get from https://dashboard.voyageai.com → API keys (free tier, no card).
VOYAGE_API_KEY=

# --- Stripe (non-India checkout, $9/mo) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay (India checkout, ₹499/mo) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- App URL (used for Stripe success/cancel redirects) ---
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
