# Copy to .env.local and fill in real values:
#   cp .env.example .env.local

# --- Clerk (auth) ---
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (database + pgvector) ---
# Get from Supabase project → Settings → API. Then run lib/supabase/schema.sql
# once in the Supabase SQL Editor to create tables + match_chunks RPC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub token (indexing; strongly recommended) ---
# Personal access token, no scopes needed for public repos.
# Without it, indexing uses anonymous requests (60/hour) and fails on real repos.
# Get from https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# --- Embeddings (gemini by default, online) ---
# EMBEDDING_PROVIDER=gemini|voyage (default: gemini).
# - gemini: Google AI Studio embedding API (768 dims).
#   Needs GEMINI_EMBEDDING_API_KEY (your AI Studio key, same free-tier key
#   as Gemini chat) + the 768-dim schema (fresh setups: schema.sql already
#   uses it; upgraders: see migration-003).
# - voyage: Voyage AI voyage-code-4 API (1024 dims). Only for comparison;
#   needs VOYAGE_API_KEY and the 1024-dim schema (see migration-001).
# (The old `local` provider was removed — EMBEDDING_PROVIDER=local now errors.)
# Switching providers requires re-indexing (different vector spaces).
EMBEDDING_PROVIDER=gemini
# Cosine-similarity cutoff for retrieval (default 0.3).
# RETRIEVAL_THRESHOLD=0.3

# --- Gemini platform key (embeddings only, NOT user BYOK) ---
# REQUIRED (default provider). Unused — and never called — in voyage mode.
# Get from https://aistudio.google.com → Get API key (free tier, no card).
# This can be the SAME key you paste as the Gemini BYOK chat key.
GEMINI_EMBEDDING_API_KEY=
# Embedding model id (bare id, no "models/" prefix). Must accept
# outputDimensionality=768 (see lib/rag/gemini.ts).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- Voyage platform key (embeddings only, NOT user BYOK) ---
# ONLY needed when EMBEDDING_PROVIDER=voyage. Unused (and never called) in
# gemini mode, even if set.
# Get from https://dashboard.voyageai.com → API keys (free tier, no card).
# VOYAGE_API_KEY=

# (Payments were removed — the app is free with no repo limits, so there
# are no Stripe/Razorpay keys. NEXT_PUBLIC_APP_URL went with them: nothing
# references it anymore. You can delete the Stripe/Razorpay/App-URL vars
# from your Vercel project too.)
